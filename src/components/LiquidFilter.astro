---
// ============================================================
// Liquid Glass · L2 折射滤镜（全站只渲染一次）
// ============================================================
// 放在 Layout.astro 的 <body> 顶部，提供 filter 供 CSS 以 backdrop-filter 引用。
//
// 【关键：必须用 backdrop-filter: url(#…)，不是 filter: url(#…)】
//   这是本项目曾走过的最大弯路：
//     · `filter` 作用于**元素自身的渲染结果** → 位移的是文字/背景色，字被推糊，纯属破坏
//     · `backdrop-filter` 作用于**元素背后的画面** → 位移的是背景内容，才是真正的"折射"
//   当初用错属性，得出"feDisplacementMap 在导航栏找不到落点"的错误结论。
//   实测（Edge/Chromium）：`backdrop-filter: url(#f)` 让导航栏区域平均色差
//   达 9.84/255、最大 146.7，而对照组为 0.00 → 背景确实被位移，技术成立。
//
// 【几何越界】滤镜区域必须外扩，否则被位移到边缘外的像素会被裁出硬线
//   —— 与历史上 backdrop-filter 那条亮带属同一类"边缘裁切"问题。
---

<svg
  width="0"
  height="0"
  aria-hidden="true"
  focusable="false"
  style="position:absolute;width:0;height:0;overflow:hidden;pointer-events:none"
>
  <defs>
    <!-- 主折射：让背后的画面产生缓慢、大尺度的液态起伏。
         参数取"隔着玻璃看"的甜点区：
           · baseFrequency 太小 → 几乎看不出扭曲；太大 → 细碎噪点像信号干扰。
             0.008 对应波长约 125px，是"液态"的合适尺度。
           · numOctaves 只用 1：feTurbulence 是出了名昂贵的图元，
             而这对**位移场**来说完全够用 —— 单八度给出平滑的大块起伏，
             观感反而更"液态"（多八度会掺入细碎噪声）。
             导航栏是全屏宽元素且滚动时每帧重算，这里省钱很关键。
           · scale = 最大位移像素数。8~14 是克制范围；> 30 会开始"撕开"画面。 -->
    <filter
      id="liquid-refract"
      x="-25%"
      y="-25%"
      width="150%"
      height="150%"
      color-interpolation-filters="sRGB"
    >
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.008"
        numOctaves="1"
        seed="7"
        result="noise"
      />
      <feDisplacementMap
        in="SourceGraphic"
        in2="noise"
        scale="12"
        xChannelSelector="R"
        yChannelSelector="G"
      />
    </filter>

    <!-- 弱折射：给 Modal 等大面积面板用。位移更小，避免整块内容被搅乱 -->
    <filter
      id="liquid-refract-soft"
      x="-10%"
      y="-10%"
      width="120%"
      height="120%"
      color-interpolation-filters="sRGB"
    >
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.006"
        numOctaves="1"
        seed="3"
        result="n"
      />
      <feDisplacementMap
        in="SourceGraphic"
        in2="n"
        scale="5"
        xChannelSelector="R"
        yChannelSelector="G"
      />
    </filter>
  </defs>
</svg>
