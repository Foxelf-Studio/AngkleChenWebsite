---
// ============================================================
// Liquid Glass · L2 折射滤镜（全站只渲染一次）
// ============================================================
// 放在 Layout.astro 的 <body> 顶部，提供两个 filter 供 CSS 以 url(#id) 引用。
//
// 【关键前提】feDisplacementMap 位移的是「元素自身的渲染结果」，
//   不是元素背后的页面。因此它只对**已经有 backdrop-filter 的元素**有意义：
//   位移作用在"已模糊的背景"上 → 真实边缘折射。
//   对无 buffer 的元素用它 = 自己歪一下、背景纹丝不动，纯属浪费。
//   本站只有「导航栏」和「Modal」满足这个前提（背后真有内容滚过）。
//
// 【几何越界】滤镜区域必须外扩，否则被位移到边缘外的像素会被裁出一条硬线
//   —— 和历史上 backdrop-filter 那条亮带属于同一类"边缘裁切"问题。
---

<svg
  width="0"
  height="0"
  aria-hidden="true"
  focusable="false"
  style="position:absolute;width:0;height:0;overflow:hidden;pointer-events:none"
>
  <defs>
    <!-- 主折射：缓慢大块的液态起伏。
         baseFrequency 太小 → 扭曲几乎看不见；太大 → 细碎噪点像信号干扰。
         0.008 左右是"液态"的甜点区。 -->
    <filter
      id="liquid-refract"
      x="-20%"
      y="-20%"
      width="140%"
      height="140%"
      color-interpolation-filters="sRGB"
    >
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.008 0.014"
        numOctaves="2"
        seed="7"
        result="noise"
      />
      <feDisplacementMap
        in="SourceGraphic"
        in2="noise"
        scale="8"
        xChannelSelector="R"
        yChannelSelector="G"
      />
    </filter>

    <!-- 弱折射：给 Modal 面板用，强度更低，避免大面板整体被撕开 -->
    <filter
      id="liquid-refract-soft"
      x="-10%"
      y="-10%"
      width="120%"
      height="120%"
      color-interpolation-filters="sRGB"
    >
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.006"
        numOctaves="1"
        seed="3"
        result="n"
      />
      <feDisplacementMap
        in="SourceGraphic"
        in2="n"
        scale="4"
        xChannelSelector="R"
        yChannelSelector="G"
      />
    </filter>
  </defs>
</svg>
