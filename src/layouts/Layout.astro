---
import "../styles/global.css";
import { getEntry } from "astro:content";
import LiquidFilter from "../components/LiquidFilter.astro";
import Lightbox from "../components/Lightbox.astro";

interface Props {
  title?: string;
  description?: string;
}

const { title = "陈叔叔的奇幻空间", description } = Astro.props;

const aboutEntry = await getEntry("about", "about");
const site = aboutEntry?.data ?? {};
const siteTitle = site.siteTitle || "陈叔叔的奇幻空间";
const siteSubtitle = site.siteSubtitle || "";
const email = site.email || "";
const github = site.github || "";
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description || siteSubtitle} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <!-- 视觉开关的偏好必须在**首次绘制前**写入 html 属性，否则会先按默认渲染
         再被 JS 纠正，出现一次可见的闪烁（FOUC）。
         故意用 is:inline —— 不能是模块脚本，模块是 defer 的，执行太晚。
         另支持 ?liquid=on|off 诊断参数（与 ?glass= 同规格），便于并排比对两种视觉。 -->
    <script is:inline>
      (function () {
        var forced = new URLSearchParams(location.search).get("liquid");
        if (forced === "on" || forced === "off") {
          document.documentElement.dataset.liquid = forced;
          document.documentElement.dataset.liquidForced = "1";
          return;
        }
        try {
          var saved = localStorage.getItem("liquidGlass");
          document.documentElement.dataset.liquid = saved === "off" ? "off" : "on";
        } catch (e) {
          document.documentElement.dataset.liquid = "on";
        }
      })();
    </script>
  </head>
  <body class="grain text-white antialiased">
    <!-- 折射滤镜定义：全站一次，供导航栏 / Modal 以 url(#liquid-refract) 引用 -->
    <LiquidFilter />

    <!-- 液态跟手层：写入元素级 --mx/--my/--lite -->
    <script>
      import "../scripts/liquid.ts";
    </script>

    <!-- 导航栏
         折射方案（feDisplacementMap）不适用于本站导航栏，原因记录在下方 CSS 注释中。
         nav 本体只用 backdrop-filter 表达玻璃，不加任何 filter。 -->
    <nav
      class="glass-nav liquid-surface liquid-sheen liquid-sheen--wide fixed top-0 left-0 right-0 z-40 px-6 md:px-8"
    >
      <div class="flex items-center justify-between max-w-6xl mx-auto gap-6 h-16">
        <a href="/" class="font-semibold text-white text-lg md:text-xl tracking-wide">
          ✨ {siteTitle}
        </a>
        <div class="hidden md:flex gap-6 text-sm text-white/80">
          <a href="/" class="hover:text-white transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]">文章</a>
          <a href="/tags" class="hover:text-white transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]">标签</a>
          <a href="/apps" class="hover:text-white transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]">陈叔叔的软件</a>
          <a href="/about" class="hover:text-white transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]">关于</a>
        </div>
        <button
          id="menuBtn"
          aria-label="打开菜单"
          class="md:hidden liquid-surface liquid-sheen liquid-sheen--tight bg-white/10 border border-white/20 rounded-2xl text-white px-3 py-1.5 text-sm shadow-[0_4px_16px_rgba(3,7,18,0.45),inset_0_1px_0_rgba(255,255,255,0.25),inset_0_-1px_0_rgba(2,6,16,0.3)] transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]"
        >
          菜单
        </button>
      </div>
    </nav>

    <!-- 移动端菜单浮层：刻意放在 <nav> 之外。
         nav 自身带 backdrop-filter，会给后代建立新的 backdrop root，
         使菜单的 backdrop-filter 只采样 nav 内部 → 页面内容不会被模糊、直接透出来。 -->
    <div id="mobileMenu" class="mobile-menu md:hidden" aria-hidden="true">
      <div class="mobile-menu__panel">
        <div class="flex flex-col max-w-6xl mx-auto px-6 md:px-8 py-3 text-sm text-white/85">
          <a href="/" class="block py-2.5 hover:text-white transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]">文章</a>
          <a href="/tags" class="block py-2.5 hover:text-white transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]">标签</a>
          <a href="/apps" class="block py-2.5 hover:text-white transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]">陈叔叔的软件</a>
          <a href="/about" class="block py-2.5 hover:text-white transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]">关于</a>
        </div>
      </div>
    </div>

    <main class="pt-16">
      <slot />
    </main>

    <!-- 页脚 -->
    <footer
      class="glass-footer text-white/80 py-16 md:py-24 px-6 md:px-8 mt-8"
    >
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <span class="font-semibold text-white text-xl md:text-2xl">✨ {siteTitle}</span>
            <p class="text-white/50 text-xs mt-3 leading-relaxed">
              {siteSubtitle || "记录技术、生活与奇思妙想。"}
            </p>
          </div>
          <div>
            <h4 class="font-semibold text-white text-base mb-3">导航</h4>
            <ul class="text-white/80 text-xs space-y-2">
              <li><a href="/" class="hover:text-[#E4B863] transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]">文章列表</a></li>
              <li><a href="/tags" class="hover:text-[#E4B863] transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]">标签分类</a></li>
              <li><a href="/apps" class="hover:text-[#E4B863] transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]">陈叔叔的软件</a></li>
              <li><a href="/about" class="hover:text-[#E4B863] transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]">关于我</a></li>
            </ul>
          </div>
          <div>
            <h4 class="font-semibold text-white text-base mb-3">联系</h4>
            <ul class="text-white/80 text-xs space-y-2">
              {email && <li class="text-white/50">Email: {email}</li>}
              {github && <li class="text-white/50">GitHub: @{github}</li>}
            </ul>
          </div>
        </div>

        <!-- 视觉开关：切换「液态玻璃」跟手高光层。
             关闭即完全还原原有玻璃拟态（不含任何高光跟手）。 -->
        <div
          class="flex items-center justify-between gap-6 flex-wrap mt-10 pt-6 border-t border-white/10"
        >
          <div>
            <div class="text-white/80 text-sm font-medium">新版视觉效果</div>
            <p class="text-white/50 text-xs mt-1 leading-relaxed">
              开启后，玻璃表面会跟随光标产生液态高光；关闭则回到原有样式。
            </p>
          </div>
          <label class="liquid-switch">
            <input
              type="checkbox"
              id="liquidToggle"
              class="sr-only"
              role="switch"
              aria-label="开启新版视觉效果"
            />
            <span class="liquid-switch__track" aria-hidden="true">
              <span class="liquid-switch__knob"></span>
            </span>
          </label>
        </div>

        <p class="text-white/50 text-xs mt-8">© 2026 {siteTitle}</p>
      </div>
    </footer>

    <!-- 图片灯箱：全站单例，点击正文图片放大查看 -->
    <Lightbox />

    <script>
      const menuBtn = document.getElementById("menuBtn");
      const mobileMenu = document.getElementById("mobileMenu");
      menuBtn?.addEventListener("click", () => {
        const isOpen = mobileMenu?.classList.toggle("is-open");
        mobileMenu?.setAttribute("aria-hidden", isOpen ? "false" : "true");
      });

      // 底栏视觉开关：切换液态玻璃跟手高光层
      const liquidToggle = document.getElementById("liquidToggle");
      if (liquidToggle) {
        // 初始状态由 <head> 的内联脚本提前写入，这里只做同步，
        // 避免"先渲染默认态再纠正"造成闪烁。
        liquidToggle.checked = document.documentElement.dataset.liquid !== "off";

        liquidToggle.addEventListener("change", () => {
          const next = liquidToggle.checked ? "on" : "off";
          document.documentElement.dataset.liquid = next;
          try {
            localStorage.setItem("liquidGlass", next);
          } catch (e) {
            // 隐私模式等 localStorage 不可用：开关当次仍生效，只是不记忆
          }
          // 通知液态层启停 rAF 循环（关闭时不该继续空转）
          document.dispatchEvent(new CustomEvent("liquidprefchange"));
        });
      }
    </script>

    <style>
      /* ============ 导航栏：液态玻璃（L1 光学材质） ============ */
      /*
         【为什么导航栏可以用 backdrop-filter 而卡片不行】
         模糊的收益 = 背后是否有「值得被模糊的内容」。
           · 导航栏背后 → 正文一直在滚动 → 模糊有真实收益，且它是整屏单例，
             不存在"相邻卡片互相采样"的场景 → 不会重演亮带 bug。
           · 卡片背后 → body 的平滑渐变 → 模糊零收益，且模糊核会越界采样
             相邻卡片的亮边框 → 亮带元凶。所以卡片继续禁用。

         【导航栏不做 feDisplacementMap 折射】结论见下方注释。
      */
      .glass-nav {
        /* 【必须显式声明】Tailwind v4 的工具类在 @layer utilities 层，
           层叠优先级低于普通 CSS 规则。历史上 .liquid-surface 里写了
           position: relative 就把这里的 .fixed 顶掉，导致导航栏跟着页面滚走。
           所以定位一律在组件级 CSS 里显式写死，不依赖工具类。 */
        position: fixed;
        /* 玻璃底提到规范上限 12%，让"透光"看得见 */
        background-color: rgba(255, 255, 255, 0.12);
        -webkit-backdrop-filter: blur(8px) saturate(160%);
        backdrop-filter: blur(8px) saturate(160%);
        border-bottom: 1px solid rgba(255, 255, 255, 0.15);
        /* 规范 3.1 的「光有方向」三件套：
           外层深阴影（把导航栏从页面上"抬起来"）
           + inset 顶部受光 + inset 底部背光 —— 玻璃因此有了厚度 */
        box-shadow:
          0 8px 32px rgba(3, 7, 18, 0.45),
          inset 0 1px 0 rgba(255, 255, 255, 0.2),
          inset 0 -1px 0 rgba(2, 6, 16, 0.35);

        /* ---- 底边柔和化开（mask） ----
           固定导航栏盖住滚动内容时，底边会形成一道"硬切"：线之上被模糊、
           线之下锐利，同一行字被拦腰切断。这是所有半透明固定导航栏的通病。
           用 mask 让玻璃在最后 14px 渐隐，边界"化开"而不是切断 ——
           更接近 Apple Liquid Glass 的柔和边缘。
           范围取 50px→64px（仅最后 14px）：导航栏文字垂直居中在 y≈23~41，
           完全不受影响。
           不支持 mask-image 的浏览器会忽略这两条，退化为原来的硬边，无副作用。 */
        -webkit-mask-image: linear-gradient(
          to bottom,
          #000 0px,
          #000 50px,
          transparent 64px
        );
        mask-image: linear-gradient(
          to bottom,
          #000 0px,
          #000 50px,
          transparent 64px
        );
        /* 与渐隐高度配套：底边淡出后，"可见玻璃"实际只到 50px，
           其视觉中心是 25px，而内容仍居中在 32px → logo 看起来偏低。
           给内容容器补 14px 下内边距（= 渐隐高度），
           居中后的内容中心回到 25px，与可见玻璃对齐。
           ⚠️ 改渐隐范围时，这里的数值要同步改（下内边距 = 64 - 渐隐起点）。 */
        --nav-fade: 14px;
      }
      .glass-nav > div {
        padding-bottom: var(--nav-fade, 14px);
      }

      /* ---- 真·折射：backdrop-filter 引用 SVG 滤镜 ----
         【这是本项目走过最大弯路的地方，务必看清】
         必须用 `backdrop-filter: url(#…)`，**不是** `filter: url(#…)`：
           · `filter` 作用于元素**自身**渲染结果 → 位移的是文字与底色，把字推糊
           · `backdrop-filter` 作用于元素**背后**的画面 → 位移的是背景内容 = 真折射
         当初用错属性，才误判"feDisplacementMap 在导航栏找不到落点"。
         受控实测（条纹置于导航栏后）：
           · 无折射 → 条纹只是被糊直
           · 有折射 → 条纹明显被弯折，而导航文字始终锐利
         导航栏区域平均色差 25.40/255（最大 54.0），确认真实生效。

         两条声明是**渐进增强**：若某浏览器不支持滤镜列表里的 url()，
         第二条整体失效，自动回退到第一条的纯模糊 —— 不会连模糊一起丢掉。 */
      html[data-glass="full"] .glass-nav {
        -webkit-backdrop-filter: blur(8px) saturate(160%);
        backdrop-filter: blur(8px) saturate(160%);
        -webkit-backdrop-filter: blur(8px) saturate(160%) url(#liquid-refract);
        backdrop-filter: blur(8px) saturate(160%) url(#liquid-refract);
      }

      /* ---- 折射层已移除 ----
         【为什么不给导航栏做 feDisplacementMap 折射】
         feDisplacementMap 位移的是「元素自身的渲染结果」，不是它背后的页面。
         实测下来它在本站导航栏没有任何能成立的落点：
           · 加在 nav 上  → 位移含文字，字形被推糊、整条 bar 因离屏重采样发灰
           · 加在独立边缘层 → 该层自身只是渐变，没有背景内容可折射，
                             位移的只是渐变本身，等于空转；再看就是一条亮带
         结论：方案 B 不适合本站导航栏。玻璃的"厚度"改由「上亮下暗的双向边框
         + inset 顶高光 + 外层深阴影」表达（规范 v1.1 的「光有方向」），
         这也是 glass.ts 既有的做法。滤镜定义保留在 LiquidFilter.astro，
         留给真正需要的场景（如未来盖在正文上的 Modal）。 */

      /* lite 档：降低模糊，减轻合成负担 */
      html[data-glass="lite"] .glass-nav {
        -webkit-backdrop-filter: blur(16px) saturate(140%);
        backdrop-filter: blur(16px) saturate(140%);
      }

      /* static / fallback：摘掉模糊，保留材质（半透明白底 + 双向边框） */
      html[data-glass="static"] .glass-nav,
      html[data-glass="fallback"] .glass-nav {
        -webkit-backdrop-filter: none;
        backdrop-filter: none;
      }

      /* ---- 底栏视觉开关 ----
         遵循 glassmorphism 规范：
           · 玻璃半透明底 8%~12%（含 hover/checked 临时态也不超 12%）
           · 双向边框 + inset 顶高光 + 外层深阴影（「光有方向」）
           · 动效只碰 transform / 边框色 / 背景色，统一 spring 缓动 500ms
           · 不用颜色单独传递状态 —— 位置位移本身即状态指示
           · 移动端触控目标 ≥ 44px（由 label 的 min-height 保证） */
      .liquid-switch {
        display: inline-flex;
        align-items: center;
        min-height: 44px; /* 触控目标 */
        flex-shrink: 0;
        cursor: pointer;
      }
      .liquid-switch__track {
        position: relative;
        width: 48px;
        height: 28px;
        /* 圆角用 1rem（= rounded-2xl）而非「胶囊」专用值，
           在 28px 高上已呈现为胶囊形，符合规范「只允许 2xl / 3xl」 */
        border-radius: 1rem;
        background-color: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.15);
        box-shadow:
          0 4px 16px rgba(3, 7, 18, 0.45),
          inset 0 1px 0 rgba(255, 255, 255, 0.22),
          inset 0 -1px 0 rgba(2, 6, 16, 0.35);
        transition: all 500ms cubic-bezier(0.16, 1, 0.3, 1);
      }
      .liquid-switch__knob {
        position: absolute;
        top: 50%;
        left: 3px;
        width: 20px;
        height: 20px;
        margin-top: -10px;
        border-radius: 9999px; /* 圆形滑块，非「圆角」场景 */
        background-color: rgba(255, 255, 255, 0.5);
        box-shadow:
          0 2px 6px rgba(3, 7, 18, 0.5),
          inset 0 1px 0 rgba(255, 255, 255, 0.45);
        transform: translateX(0); /* 只做合成层动画 */
        will-change: transform;
        transition:
          transform 500ms cubic-bezier(0.16, 1, 0.3, 1),
          background-color 500ms cubic-bezier(0.16, 1, 0.3, 1);
      }

      /* hover 光效：边框提升 + 亮度提升（外阴影结构保持一致，不加深） */
      .liquid-switch:hover .liquid-switch__track {
        background-color: rgba(255, 255, 255, 0.12);
        border-color: rgba(255, 255, 255, 0.3);
      }

      /* 开启态：滑块右移 + 提亮。位置变化是非颜色线索，不违反
         「禁止用颜色单独传递状态」。 */
      #liquidToggle:checked ~ .liquid-switch__track {
        background-color: rgba(255, 255, 255, 0.12);
        border-color: rgba(255, 255, 255, 0.3);
      }
      #liquidToggle:checked ~ .liquid-switch__track .liquid-switch__knob {
        transform: translateX(22px); /* 48 - 3 - 20 - 3 = 22 */
        background-color: rgba(255, 255, 255, 0.95);
      }

      /* 焦点环：仅键盘触发（规范 3.4） */
      #liquidToggle:focus-visible ~ .liquid-switch__track {
        outline: none;
        box-shadow:
          0 0 0 3px rgba(228, 184, 99, 0.15),
          0 4px 16px rgba(3, 7, 18, 0.45),
          inset 0 1px 0 rgba(255, 255, 255, 0.22),
          inset 0 -1px 0 rgba(2, 6, 16, 0.35);
      }

      /* ---- 底栏：柔化顶边 ----
         原设计是 `bg-white/8 ... border-t border-white/15`，在整屏宽上会产生
         一道硬边：1px 亮线（实测亮度 88，而上下只有 43/59）+ 8% 白带来的
         +16 亮度台阶。在页脚这种满宽面板上，这道硬边看起来就是"一条亮带"。

         柔化做法（保留「光有方向」，但取消硬边）：
           1. 底色改为**纵向渐变**：从接近 0 平滑爬到 8%（160px 内完成），
              这样元素边界处没有突变，台阶被摊开成过渡。
           2. 顶边受光改用**两端渐隐**的细高光，而非满宽实线。 */
      .glass-footer {
        position: relative;
        background-color: transparent;
        background-image: linear-gradient(
          to bottom,
          rgba(255, 255, 255, 0) 0px,
          rgba(255, 255, 255, 0.08) 180px,
          rgba(255, 255, 255, 0.08) 100%
        );
        /* 【刻意不加 backdrop-filter】
           理由与本项目已确立的规则 5 完全一致（见 glass.ts / 规范 v1.1）：
           footer 背后只有 body 的平滑渐变，模糊**零收益**；
           而 backdrop-saturate(180%) 会在元素边界造成颜色台阶，
           反而在页脚顶部切出一道可见的界线。
           只有「背后会滚过正文的导航栏」「盖在正文上的浮层」才需要它。 */
      }
      /* 顶边不再单独画受光高光。
         原因：任何"只在 footer 内部变亮"的处理都会在边界造出
         「上亮下暗、且比上方也亮」的一条带 —— 那正是要消除的东西。
         实测数据：加 20px 渐隐光晕后，顶边仍有 17 级亮度突跳（43→62）。
         改为让背景**从 0 起步**，边界处与上方无缝，再缓慢爬到 8%。 */

      /* 移动端菜单：做成导航栏的「向下延伸」。
         面板与导航栏用同一套玻璃配方，收起时整体藏在导航栏底边上方（被裁掉），
         展开时整体向下滑出 —— 观感就是「导航栏自己变高、长出菜单」。
         性能：全程只动 transform（GPU 合成层），不碰 height / grid-template-rows，
         因此不会逐帧 reflow，移动端不会掉帧。 */
      .mobile-menu {
        position: fixed;
        top: 4rem; /* 紧接导航栏底边（h-16） */
        left: 0;
        right: 0;
        z-index: 30; /* 低于 nav(z-40)，收起时即使溢出也被导航栏压住 */
        overflow: hidden; /* 收起时裁掉面板 */
        pointer-events: none;
      }

      .mobile-menu__panel {
        /* 与导航栏完全同一套玻璃配方，做到无缝衔接 */
        background-color: rgba(255, 255, 255, 0.08);
        -webkit-backdrop-filter: blur(40px) saturate(180%);
        backdrop-filter: blur(40px) saturate(180%);
        border-bottom: 1px solid rgba(255, 255, 255, 0.15);
        transform: translateY(-100%);
        will-change: transform;
        transition: transform 420ms cubic-bezier(0.16, 1, 0.3, 1);
      }

      .mobile-menu.is-open {
        pointer-events: auto;
      }
      .mobile-menu.is-open .mobile-menu__panel {
        transform: translateY(0);
      }

      /* 菜单项逐个「浮现」：面板整体滑出的同时，各选项依次淡入并轻微下沉到位，
         避免所有选项僵直地跟着面板一起平移。同样只用 transform / opacity。 */
      .mobile-menu__panel a {
        opacity: 0;
        transform: translateY(-10px);
        transition:
          opacity 240ms cubic-bezier(0.16, 1, 0.3, 1),
          transform 340ms cubic-bezier(0.16, 1, 0.3, 1);
      }
      .mobile-menu.is-open .mobile-menu__panel a {
        opacity: 1;
        transform: translateY(0);
      }
      /* 打开时逐项错峰；关闭时不设 delay，立即收回 */
      .mobile-menu.is-open .mobile-menu__panel a:nth-child(1) { transition-delay: 70ms; }
      .mobile-menu.is-open .mobile-menu__panel a:nth-child(2) { transition-delay: 115ms; }
      .mobile-menu.is-open .mobile-menu__panel a:nth-child(3) { transition-delay: 160ms; }
      .mobile-menu.is-open .mobile-menu__panel a:nth-child(4) { transition-delay: 205ms; }

      /* 尊重系统「减少动态效果」偏好 */
      @media (prefers-reduced-motion: reduce) {
        .mobile-menu__panel,
        .mobile-menu__panel a {
          transition-duration: 1ms !important;
          transition-delay: 0ms !important;
        }
      }
    </style>
  </body>
</html>
