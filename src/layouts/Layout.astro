---
import "../styles/global.css";
import { getEntry } from "astro:content";

interface Props {
  title?: string;
  description?: string;
}

const { title = "陈叔叔的奇幻空间", description } = Astro.props;

const aboutEntry = await getEntry("about", "about");
const site = aboutEntry?.data ?? {};
const siteTitle = site.siteTitle || "陈叔叔的奇幻空间";
const siteSubtitle = site.siteSubtitle || "";
const email = site.email || "";
const github = site.github || "";
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description || siteSubtitle} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="grain text-white antialiased">
    <!-- 导航栏 -->
    <nav
      class="fixed top-0 left-0 right-0 z-40 bg-white/8 backdrop-blur-[40px] backdrop-saturate-[180%] border-b border-white/15 px-6 md:px-8"
    >
      <div class="flex items-center justify-between max-w-6xl mx-auto gap-6 h-16">
        <a href="/" class="font-semibold text-white text-lg md:text-xl tracking-wide">
          ✨ {siteTitle}
        </a>
        <div class="hidden md:flex gap-6 text-sm text-white/80">
          <a href="/" class="hover:text-white transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]">文章</a>
          <a href="/tags" class="hover:text-white transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]">标签</a>
          <a href="/apps" class="hover:text-white transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]">陈叔叔的软件</a>
          <a href="/about" class="hover:text-white transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]">关于</a>
        </div>
        <button
          id="menuBtn"
          aria-label="打开菜单"
          class="md:hidden bg-white/10 backdrop-blur-[40px] backdrop-saturate-[180%] border border-white/20 rounded-2xl text-white px-3 py-1.5 text-sm shadow-[0_4px_16px_rgba(3,7,18,0.45),inset_0_1px_0_rgba(255,255,255,0.25),inset_0_-1px_0_rgba(2,6,16,0.3)] transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]"
        >
          菜单
        </button>
      </div>
      <div id="mobileMenu" class="mobile-menu md:hidden" aria-hidden="true">
        <div class="mobile-menu__inner">
          <div class="flex flex-col gap-3 text-sm text-white/80 max-w-6xl mx-auto pb-4">
            <a href="/" class="hover:text-white">文章</a>
            <a href="/tags" class="hover:text-white">标签</a>
            <a href="/apps" class="hover:text-white">陈叔叔的软件</a>
            <a href="/about" class="hover:text-white">关于</a>
          </div>
        </div>
      </div>
    </nav>

    <main class="pt-16">
      <slot />
    </main>

    <!-- 页脚 -->
    <footer
      class="bg-white/8 backdrop-blur-[60px] backdrop-saturate-[180%] border-t border-white/15 text-white/80 py-16 md:py-24 px-6 md:px-8 mt-8"
    >
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <span class="font-semibold text-white text-xl md:text-2xl">✨ {siteTitle}</span>
            <p class="text-white/50 text-xs mt-3 leading-relaxed">
              {siteSubtitle || "记录技术、生活与奇思妙想。"}
            </p>
          </div>
          <div>
            <h4 class="font-semibold text-white text-base mb-3">导航</h4>
            <ul class="text-white/80 text-xs space-y-2">
              <li><a href="/" class="hover:text-[#E4B863] transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]">文章列表</a></li>
              <li><a href="/tags" class="hover:text-[#E4B863] transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]">标签分类</a></li>
              <li><a href="/apps" class="hover:text-[#E4B863] transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]">陈叔叔的软件</a></li>
              <li><a href="/about" class="hover:text-[#E4B863] transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]">关于我</a></li>
            </ul>
          </div>
          <div>
            <h4 class="font-semibold text-white text-base mb-3">联系</h4>
            <ul class="text-white/80 text-xs space-y-2">
              {email && <li class="text-white/50">Email: {email}</li>}
              {github && <li class="text-white/50">GitHub: @{github}</li>}
            </ul>
          </div>
        </div>
        <p class="text-white/50 text-xs mt-10">© 2026 {siteTitle} · 用 ❤️ 和 Markdown 构建</p>
      </div>
    </footer>

    <script>
      const menuBtn = document.getElementById("menuBtn");
      const mobileMenu = document.getElementById("mobileMenu");
      menuBtn?.addEventListener("click", () => {
        const isOpen = mobileMenu?.classList.toggle("is-open");
        mobileMenu?.setAttribute("aria-hidden", isOpen ? "false" : "true");
      });
    </script>

    <style>
      /* 移动端菜单：由上到下展开。
         高度 0 → auto 用 grid 行高过渡（自动适配内容高度，无需写死 max-height） */
      .mobile-menu {
        display: grid;
        grid-template-rows: 0fr;
        transition: grid-template-rows 500ms cubic-bezier(0.16, 1, 0.3, 1);
      }
      .mobile-menu.is-open {
        grid-template-rows: 1fr;
      }

      .mobile-menu__inner {
        overflow: hidden;
      }

      /* 内容整体从上方 -14px 平移下来 + 淡入，非线性（快出慢收） */
      .mobile-menu__inner > div {
        transform: translateY(-14px);
        opacity: 0;
        visibility: hidden;
        transition:
          transform 500ms cubic-bezier(0.16, 1, 0.3, 1),
          opacity 400ms cubic-bezier(0.16, 1, 0.3, 1),
          visibility 0s linear 500ms;
      }
      .mobile-menu.is-open .mobile-menu__inner > div {
        transform: translateY(0);
        opacity: 1;
        visibility: visible;
        transition:
          transform 500ms cubic-bezier(0.16, 1, 0.3, 1),
          opacity 400ms cubic-bezier(0.16, 1, 0.3, 1),
          visibility 0s;
      }

      /* 菜单项逐项错峰下滑，强化「由上到下」的层次感 */
      .mobile-menu__inner > div > a {
        opacity: 0;
        transform: translateY(-10px);
        transition:
          transform 500ms cubic-bezier(0.16, 1, 0.3, 1),
          opacity 400ms cubic-bezier(0.16, 1, 0.3, 1);
      }
      .mobile-menu.is-open .mobile-menu__inner > div > a {
        opacity: 1;
        transform: translateY(0);
      }
      .mobile-menu.is-open .mobile-menu__inner > div > a:nth-child(1) { transition-delay: 40ms; }
      .mobile-menu.is-open .mobile-menu__inner > div > a:nth-child(2) { transition-delay: 80ms; }
      .mobile-menu.is-open .mobile-menu__inner > div > a:nth-child(3) { transition-delay: 120ms; }
      .mobile-menu.is-open .mobile-menu__inner > div > a:nth-child(4) { transition-delay: 160ms; }

      /* 尊重系统「减少动态效果」偏好 */
      @media (prefers-reduced-motion: reduce) {
        .mobile-menu,
        .mobile-menu__inner > div,
        .mobile-menu__inner > div > a {
          transition-duration: 1ms !important;
          transition-delay: 0ms !important;
        }
      }
    </style>
  </body>
</html>
