---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { card, btn, tagChip, trans } from "../../lib/glass";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function fmt(d: Date) {
  return d.toISOString().slice(0, 10);
}
---

<Layout title={`${post.data.title} · 陈叔叔的奇幻空间`}>
  <section class="py-16 md:py-24 px-6 md:px-8">
    <article class="max-w-3xl mx-auto fade-in">
      <a href="/" class="text-white/50 text-xs hover:text-[#E4B863] {trans}">← 返回文章列表</a>
      <h1 class="font-semibold text-white text-3xl md:text-5xl mt-6 leading-tight">{post.data.title}</h1>
      <div class="flex flex-wrap items-center gap-4 mt-5 text-xs text-white/50">
        <span>{fmt(post.data.date)}</span>
        {post.data.tags.map((t) => (
          <a href={`/tags/${t}`} class={tagChip}>{t}</a>
        ))}
      </div>
      <div class={`${card} p-6 md:p-8 mt-8`}>
        <div class="md-body">
          <Content />
        </div>
      </div>
      <div class="mt-8">
        <a href="/" class={`${btn} inline-block px-6 py-3 text-sm`}>← 更多文章</a>
      </div>
    </article>
  </section>
</Layout>
