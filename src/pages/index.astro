---
import Layout from "../layouts/Layout.astro";
import { getCollection, getEntry } from "astro:content";
import { card, cardHover, cta, tagChip, trans } from "../lib/glass";
import EmptyState from "../components/EmptyState.astro";

const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const aboutEntry = await getEntry("about", "about");
const siteSubtitle = aboutEntry?.data.siteSubtitle || "记录技术、生活与奇思妙想。";
const heroName = aboutEntry?.data.heroName || "陈叔叔";
const heroCta = aboutEntry?.data.heroCta || "看看我做的软件 →";
const heroCtaLink = aboutEntry?.data.heroCtaLink || "/apps";

function fmt(d: Date) {
  return d.toISOString().slice(0, 10);
}
---

<Layout title="陈叔叔的奇幻空间">
  <section class="py-16 md:py-24 px-6 md:px-8">
    <div class="max-w-4xl mx-auto fade-in">
      <h1 class="font-semibold text-white text-4xl md:text-6xl leading-tight">
        你好，我是<span class="text-[#E4B863]">{heroName}</span>。
      </h1>
      <p class="text-white/80 text-sm md:text-base max-w-xl mt-6 leading-relaxed">
        {siteSubtitle}
      </p>
      <div class="mt-8">
        <a href={heroCtaLink} class={`${cta} inline-block px-6 py-3 text-sm`}>{heroCta}</a>
      </div>
    </div>
  </section>

  <section class="pb-16 md:pb-24 px-6 md:px-8">
    <div class="max-w-6xl mx-auto">
      <h2 class="font-semibold text-white text-2xl md:text-3xl mb-8">最新文章</h2>
      {
        posts.length === 0 ? (
          <EmptyState
            icon="✍️"
            title="还没有文章"
            message="这里还很安静。等我写下第一篇，它就会出现在这里。"
            actionLabel="看看我做的软件"
            actionHref="/apps"
            actionPrimary
          />
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {posts.map((post) => (
              <a
                href={`/post/${post.id}`}
                data-post-id={post.id}
                class={`block ${card} ${cardHover} ${trans} p-6 md:p-8`}
              >
                <div class="flex items-center gap-3 text-xs text-white/50 mb-3">
                  <span>{fmt(post.data.date)}</span>
                  <span data-reading-mark class="hidden items-center gap-2">
                    <span class="w-1 h-1 rounded-full bg-[#E4B863]"></span>
                    <span class="text-[#E4B863]">阅读中</span>
                  </span>
                </div>
                <h3 class="font-semibold text-white text-xl md:text-2xl mb-2">{post.data.title}</h3>
                <p class="text-white/50 text-sm md:text-base leading-relaxed mb-4">{post.data.excerpt}</p>
                <div class="flex flex-wrap gap-2">
                  {post.data.tags.map((t) => (
                    <span class={tagChip}>{t}</span>
                  ))}
                </div>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </section>
</Layout>

<script>
  // 只给「上一次阅读的那一篇」显示「阅读中」标记
  try {
    const lastRead = localStorage.getItem("lastReadPost");
    if (lastRead) {
      document.querySelectorAll("[data-post-id]").forEach((el) => {
        if (el.getAttribute("data-post-id") === lastRead) {
          const mark = el.querySelector("[data-reading-mark]");
          if (mark) {
            mark.classList.remove("hidden");
            mark.classList.add("inline-flex");
          }
        }
      });
    }
  } catch (e) {
    // 隐私模式等场景下 localStorage 不可用，静默忽略
  }
</script>
