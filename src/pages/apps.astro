---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { card, cardHover, btn, tagChip, trans } from "../lib/glass";

const apps = await getCollection("apps");
---

<Layout title="陈叔叔的软件 · 陈叔叔的奇幻空间">
  <section class="py-16 md:py-24 px-6 md:px-8">
    <div class="max-w-6xl mx-auto fade-in">
      <h1 class="font-semibold text-white text-3xl md:text-5xl">陈叔叔的软件</h1>
      <p class="text-white/80 text-sm md:text-base mt-4 max-w-xl leading-relaxed">
        这些年随手做的小工具，全部免费、无广告、本地优先。如果喜欢，欢迎来文章里留言告诉我。
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-10">
        {
          apps.map((app) => (
            <div class={`${card} ${cardHover} ${trans} p-6 md:p-8`}>
              <div class="text-3xl mb-4">{app.data.icon}</div>
              <div class="flex items-center justify-between gap-4 mb-2">
                <h3 class="font-semibold text-white text-xl md:text-2xl">{app.data.name}</h3>
                <span class="text-[#E4B863] text-xs font-mono">{app.data.version}</span>
              </div>
              <span class={tagChip}>{app.data.tag}</span>
              <p class="text-white/50 text-sm leading-relaxed mt-3">{app.data.description}</p>
              <div class="mt-5">
                <button class={`${btn} px-5 py-2 text-xs`}>下载</button>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
