---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { card, trans } from "../lib/glass";

const posts = await getCollection("posts");

const map = new Map<string, typeof posts>();
for (const p of posts) {
  for (const t of p.data.tags) {
    if (!map.has(t)) map.set(t, []);
    map.get(t)!.push(p);
  }
}
const groups = [...map.entries()].sort((a, b) => a[0].localeCompare(b[0]));

function fmt(d: Date) {
  return d.toISOString().slice(0, 10);
}
---

<Layout title="标签 · 陈叔叔的奇幻空间">
  <section class="py-16 md:py-24 px-6 md:px-8">
    <div class="max-w-4xl mx-auto fade-in">
      <h1 class="font-semibold text-white text-3xl md:text-5xl">标签分类</h1>
      <p class="text-white/50 text-sm md:text-base mt-4">按主题浏览所有文章。</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-10">
        {
          groups.map(([tag, list]) => (
            <div class={`${card} p-6 md:p-8`}>
              <a
                href={`/tags/${tag}`}
                class={`font-semibold text-white text-xl md:text-2xl hover:text-[#E4B863] ${trans}`}
              >
                # {tag} <span class="text-white/50 text-sm font-normal">({list.length})</span>
              </a>
              <ul class="mt-4 space-y-2">
                {list.map((p) => (
                  <li>
                    <a href={`/post/${p.id}`} class={`text-white/80 text-sm hover:text-[#E4B863] ${trans}`}>
                      {p.data.title}
                    </a>
                    <span class="text-white/50 text-xs ml-2">{fmt(p.data.date)}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
