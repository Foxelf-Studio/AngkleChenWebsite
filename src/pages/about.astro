---
import Layout from "../layouts/Layout.astro";
import { getEntry, render } from "astro:content";
import { card } from "../lib/glass";

const about = await getEntry("about", "about");
const email = about?.data.email ?? "";
const github = about?.data.github ?? "";
const { Content } = about ? await render(about) : { Content: null };
---

<Layout title="关于 · 陈叔叔的奇幻空间">
  <section class="py-16 md:py-24 px-6 md:px-8">
    <div class="max-w-3xl mx-auto fade-in">
      <h1 class="font-semibold text-white text-3xl md:text-5xl">关于陈叔叔</h1>
      <div class={`${card} p-6 md:p-8 mt-10`}>
        <div class="md-body">
          {Content && <Content />}
        </div>
        {
          (email || github) && (
            <div class="md-body mt-8">
              <h2>找到我</h2>
              <p>
                {email && <>Email: {email}<br /></>}
                {github && <>GitHub: @{github}</>}
              </p>
            </div>
          )
        }
      </div>
    </div>
  </section>
</Layout>
