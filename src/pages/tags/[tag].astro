---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { card, cardHover, trans } from "../../lib/glass";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const tags = new Set<string>();
  for (const p of posts) {
    for (const t of p.data.tags) tags.add(t);
  }
  return [...tags].map((tag) => ({ params: { tag }, props: { tag } }));
}

const { tag } = Astro.props;
const posts = (await getCollection("posts")).filter((p) =>
  p.data.tags.includes(tag)
);

function fmt(d: Date) {
  return d.toISOString().slice(0, 10);
}
---

<Layout title={`# ${tag} · 陈叔叔的奇幻空间`}>
  <section class="py-16 md:py-24 px-6 md:px-8">
    <div class="max-w-4xl mx-auto fade-in">
      <a href="/tags" class="text-white/50 text-xs hover:text-[#E4B863] {trans}">← 所有标签</a>
      <h1 class="font-semibold text-white text-3xl md:text-5xl mt-6"># {tag}</h1>
      <div class="grid grid-cols-1 gap-6 mt-10">
        {
          posts.map((post) => (
            <a
              href={`/post/${post.id}`}
              class={`block ${card} ${cardHover} ${trans} p-6 md:p-8`}
            >
              <div class="text-xs text-white/50 mb-2">{fmt(post.data.date)}</div>
              <h3 class="font-semibold text-white text-xl md:text-2xl mb-2">{post.data.title}</h3>
              <p class="text-white/50 text-sm">{post.data.excerpt}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
